# =============================================================
# PlaceTrack Environment Configuration
# Target Database: Firebase Cloud Firestore & Firebase Admin SDK
# =============================================================

# Application Session Signing Secret (Required for encrypted cookies)
SESSION_SECRET=placetrack-super-secret-signing-key-2026

# -------------------------------------------------------------
# 1. Firebase Admin SDK Configuration (Primary Server Database)
# -------------------------------------------------------------
# Download Service Account Key JSON from Firebase Console:
# Project Settings -> Service Accounts -> "Generate New Private Key"
FIREBASE_PROJECT_ID=placetrack-placement
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@placetrack-placement.iam.gserviceaccount.com
# Use \n escaped private key string or use FIREBASE_SERVICE_ACCOUNT_PATH
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Alternative: Provide relative or absolute path to serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Local Emulator Suite: Set to true when running local Firebase Emulator (port 8080)
# Run `npm run emulators` to start local Firestore emulator
USE_FIREBASE_EMULATOR=false
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# -------------------------------------------------------------
# 2. Firebase Client SDK Configuration (Browser Client SDK)
# -------------------------------------------------------------
# Found in Firebase Console -> Project Settings -> General -> Your Apps (Web App)
PUBLIC_FIREBASE_API_KEY=AIzaSyDummyKeyForPlacementSystem2026
PUBLIC_FIREBASE_AUTH_DOMAIN=placetrack-placement.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=placetrack-placement
PUBLIC_FIREBASE_STORAGE_BUCKET=placetrack-placement.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# -------------------------------------------------------------
# 3. AI / ML Microservice & Gemini Configuration
# -------------------------------------------------------------
FASTAPI_URL=http://127.0.0.1:8000
ML_SERVICE_SECRET=placetrack-internal-ml-secret-2026
GEMINI_API_KEY=

# -------------------------------------------------------------
# 4. Legacy PostgreSQL Database Connection (Migration Source)
# -------------------------------------------------------------
# Kept as fallback/secondary data source during migration.
# Run `npm run db:migrate` to safely migrate PostgreSQL data into Firestore.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/placetrack
