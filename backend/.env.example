# =============================================================
# PlaceTrack AI — Python ML Backend Environment Configuration
# Deployment Target: Render (Web Service)
# =============================================================

# Server Port (Render sets this dynamically via $PORT)
PORT=8000
HOST=0.0.0.0

# Pre-shared internal service secret key (Must match frontend ML_SERVICE_SECRET)
ML_SERVICE_SECRET=placetrack-internal-ml-secret-2026

# Production frontend URL for CORS (Vercel deployment URL)
# Example: FRONTEND_URL=https://placetrack-frontend.vercel.app
FRONTEND_URL=http://localhost:5173
